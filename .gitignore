# Data — per-step datasets (.gitignored, keep .gitkeep)
**/data/*
!**/data/.gitkeep

# Models — weights too large for git (keep READMEs)
**/models/*
!**/models/README.md

# Results — generated during training (keep READMEs)
**/results/*
!**/results/README.md

# But keep small fixtures for tests
!**/tests/fixtures/*.json
!**/tests/fixtures/*.png

